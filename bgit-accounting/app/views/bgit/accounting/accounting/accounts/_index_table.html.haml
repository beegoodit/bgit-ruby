= table.id sort: true
= table.column :number, sort: true
= table.column :name, sort: true do |resource|
  - resource.name.truncate(32)
= table.association :keepr_group, label_method: ->(r) { r.name.truncate(32) }, link_to: ->(r) { accounting_group_path(r.keepr_group) }
= table.column :balance_debit do |resource|
  - resource.balance_debit
= table.column :balance_credit do |resource|
  - resource.balance_credit
= table.column :balance
