= table.id sort: true
= table.association :accountable, label_method: :human
= table.field :number, sort: true
= table.date :date, sort: true
= table.field :subject
= table.boolean :permanent
= table.field :keepr_debit_postings do |resource|
  - capture_haml do
    - resource.keepr_postings.debits.all.each do |posting|
      %span.badge.badge-primary= posting.human
= table.field :separator, title: false do |resource|
  - capture_haml do
    %i.fas.fa-arrow-right
= table.field :keepr_credit_postings do |resource|
  - capture_haml do
    - resource.keepr_postings.credits.all.each do |posting|
      %span.badge.badge-primary= posting.human
= table.field :note