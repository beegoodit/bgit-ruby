.row
  .col-12
    %h3= Bgit::Accounting::Accounting::Account.model_name.human(count: :other)

- if @resource.supplier_account.present?
  .row
    .col-12
      .card.mb-4
        .card-header.d-flex.justify-content-between
          = @resource.supplier_account.human
          .card-actions
            .btn-group
              = link_to([@resource.supplier_account], class: "btn btn-xs btn-primary") do
                %i.fas.fa-eye
                = t(".show")
              = link_to([:edit, @resource.supplier_account], class: "btn btn-xs btn-secondary") do
                %i.fas.fa-edit
                = t(".edit")
              = link_to([@resource.supplier_account], class: "btn btn-xs btn-danger", method: :destroy, data: { confirm: t(".confirm") }) do
                %i.fas.fa-fire
                = t(".destroy")
        .card-body
          = resource_table(resource: @resource.supplier_account, table_html: "table mb-0") do |table|
            = render partial: "/bgit/accounting/accounting/accounts/show_table", locals: { table: table, resource: @resource.supplier_account }


