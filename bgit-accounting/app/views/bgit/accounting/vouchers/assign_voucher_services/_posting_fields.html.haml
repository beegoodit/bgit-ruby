.nested-fields{ id: "#{uuid = SecureRandom.uuid}" }
  
  = form.input :keepr_account_id, collection: Bgit::Accounting::Accounting::Account.expenses.all.collect { |c| [c.human, c.id] }, input_html: { class: 'account_id form-control' }
  = form.input :amount, input_html: { class: 'net_amount' }

  - form.object.side ||= "debit"
  = form.input :side, collection: %w[debit credit].collect { |k| [k, k]  }, input_html: { class: 'form-control', readonly: true }
  .link_to_remove_association.btn.btn-danger
    %i.fas.fa-minus
    %span.btn-text= "Posting entfernen"

  %hr
