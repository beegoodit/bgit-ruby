- if form.object.voucher_id.nil?
  = form.input :voucher_id, collection: Bgit::Accounting::Vouchers::Voucher.all.collect { |c| [c.human, c.id] }

  :javascript
    // on change of voucher_id select, reload the page with the selected voucher_id
    $(document).on("change", "select#vouchers_assign_voucher_service_voucher_id", function() {
      var voucher_id = $(this).val();
      var url = new URL(window.location.href);
      url.searchParams.set("vouchers_assign_voucher_service[voucher_id]", voucher_id);
      window.location.href = url.href;
    });

- else
  = form.input :voucher_id, as: :hidden

.row
  .col-12.col-md-6
    = form.input :type, as: :select, collection: Bgit::Accounting::Vouchers::Voucher::ASSIGNABLE_VOUCHER_TYPES.collect { |c| [c.constantize.model_name.human, c] }, input_html: { class: 'form-control' }
  .col-12.col-md-6
    = form.input :voucher_number

.row
  .col-12.col-md-6
    = form.input :voucher_date, as: :date_picker
  .col-12.col-md-6
    = form.input :due_date, as: :date_picker
= form.input :description, as: :text

%hr

#amounts.mb-4
  = form.fields_for "amounts[]", Bgit::Accounting::Vouchers::Amount.new do |af|
    = render "amount_fields", form: af
    .links
      .link_to_add_association.btn.btn-primary
        %i.fas.fa-plus
        %span.btn-text= "Betrag aufteilen"

