.nested-fields{ id: "#{uuid = SecureRandom.uuid}" }
  = form.input :net_amount, input_html: { class: 'net_amount' }
  = form.input :tax_amount, input_html: { class: 'tax_amount' }
  = form.input :tax_rate_percentage, collection: [0, 7, 19].collect { |p| ["#{p}%", p] }, input_html: { class: 'tax_rate_percentage form-control' }
  = form.input :account_id, collection: Bgit::Accounting::Accounting::Account.where(accountable: @service.accountable).all.collect { |c| [c.human, c.id] }, input_html: { class: 'account_id form-control' }
  .link_to_remove_association.btn.btn-danger
    %i.fas.fa-minus
    %span.btn-text= "Betrag entfernen"

  %hr

