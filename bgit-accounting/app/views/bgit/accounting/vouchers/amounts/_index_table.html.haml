= table.id sort: true
= table.association :voucher, label_method: :human, link_to: ->(resource) { url_for(resource.voucher.becomes(resource.voucher.class.base_class)) }
= table.association :account, label_method: ->(a) { "#{a.accountable.human}: #{a.human}" }, link_to: ->(resource) { url_for(resource.account) }
= table.money :net_amount, sort: true
= table.money :tax_amount, sort: true
= table.money :gross_amount, sort: true
= table.field :tax_rate_percentage, sort: true
= table.timestamps sort: true
